# ==========================================================================
# Alfa VpnTunnel Managment — نمونه فایل تنظیمات
# این فایل را کپی کنید به .env و مقادیر را تنظیم کنید.
# نکته: installer مقادیر امنیتی (SECRET_KEY، پسورد دیتابیس و ...) را خودش
# به صورت تصادفی و امن می‌سازد؛ نیازی به پر کردن دستی آن‌ها نیست.
# هیچ Secret واقعی را در گیت commit نکنید.
# ==========================================================================

# ---------------------------- عمومی ----------------------------
ENVIRONMENT=production          # development | testing | production
DEBUG=false                     # در Production همیشه false
PANEL_NAME=Alfa VpnTunnel Managment
PANEL_URL=http://localhost      # آدرس نهایی پنل؛ در دستور نصب Agent استفاده می‌شود
PANEL_PORT=8080                 # پورت منطقی پنل
HTTP_PORT=8080                  # پورتی که Nginx روی HTTP گوش می‌دهد
HTTPS_PORT=8443                 # پورت HTTPS (با دامنه: 443)
PANEL_DOMAIN=                   # دامنه پنل؛ خالی = دسترسی با IP
ENABLE_HTTPS=false              # true فقط وقتی دامنه دارید
LETSENCRYPT_EMAIL=              # ایمیل صدور گواهی
TIMEZONE=Asia/Tehran            # منطقه زمانی پیش‌فرض
LOG_LEVEL=INFO                  # DEBUG | INFO | WARNING | ERROR
ENABLE_DOCS=false               # فعال کردن Swagger روی /api/v1/docs (در Production پیشنهاد نمی‌شود)
ALFA_DATA=/var/lib/alfa         # مسیر داده‌ها و پشتیبان‌ها روی هاست

# ---------------------------- دیتابیس ----------------------------
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=alfa
POSTGRES_USER=alfa
POSTGRES_PASSWORD=change-me     # installer مقدار تصادفی می‌گذارد
# DATABASE_URL=postgresql+asyncpg://user:pass@host:5432/db   # اگر خارج از Docker است

# ---------------------------- Redis ----------------------------
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_ENABLED=true              # برای Rate Limit توزیع‌شده؛ در نصب تک‌سروری هم مفید است

# ---------------------------- امنیت ----------------------------
SECRET_KEY=change-me            # کلید امضای نشست/JWT — حتماً تصادفی و طولانی
SECRETS_ENCRYPTION_KEY=         # کلید رمزنگاری Secretها (At-Rest). چند کلید با کاما = چرخش کلید
SESSION_TTL_MINUTES=720         # مدت اعتبار نشست
COOKIE_SECURE=false             # با HTTPS مقدار true بگذارید
COOKIE_SAMESITE=lax             # lax | strict | none
CORS_ORIGINS=                   # فقط برای توسعه: http://localhost:5173
PASSWORD_MIN_LENGTH=12
LOGIN_RATE_LIMIT=10/5m          # سقف تلاش ورود
API_RATE_LIMIT=300/1m
AGENT_RATE_LIMIT=600/1m
MAX_FAILED_LOGINS=8             # پس از این تعداد، قفل موقت حساب
LOCKOUT_MINUTES=15
ENABLE_2FA=true                 # اجازه فعال‌سازی TOTP توسط کاربران

# ---------------------------- Agent ----------------------------
AGENT_PORT=9443                 # پورت پیش‌فرض Agent روی سرورها
AGENT_TLS_VERIFY=false          # Agentها گواهی self-signed دارند؛ با CA معتبر true کنید
AGENT_REQUEST_TIMEOUT=20
AGENT_HEARTBEAT_INTERVAL=15     # ثانیه
AGENT_OFFLINE_AFTER_MISSED=3    # تعداد Heartbeat ازدست‌رفته تا Offline شدن سرور
AGENT_TOKEN_ROTATION_DAYS=30    # چرخش خودکار توکن Agent

# ---------------------------- مانیتورینگ و نگهداشت ----------------------------
METRICS_INTERVAL_SECONDS=20
METRIC_RETENTION_DAYS=7         # نگهداشت متریک خام
METRIC_AGG_RETENTION_DAYS=180   # نگهداشت متریک تجمیع‌شده
TRAFFIC_RETENTION_DAYS=365
LOG_RETENTION_DAYS=30
SCHEDULER_ENABLED=true          # کارهای پس‌زمینه (هشدار، پاک‌سازی، پشتیبان خودکار)

# ---------------------------- حالت توسعه ----------------------------
MOCK_MODE=false                 # داده شبیه‌سازی‌شده؛ در Production همیشه غیرفعال می‌شود
DEMO_DATA=false                 # ساخت سرور/تونل نمونه در محیط توسعه

# ---------------------------- مسیرها ----------------------------
DATA_DIR=/var/lib/alfa
BACKUP_DIR=/var/lib/alfa/backups
TUNNEL_BINARY_DIR=/opt/alfa/tunnel-binaries   # محل نگهداری Binaryهای تونل

# ==========================================================================
# منابع تونل‌ها — این‌ها را بعداً پر کنید (یا از پنل: تنظیمات ← انواع تونل)
# تا وقتی خالی باشند، آن تونل در UI با وضعیت «تنظیم‌نشده» نمایش داده می‌شود.
# ==========================================================================
# Binaryهای اختصاصی: فایل را روی سرور کپی کنید و مسیر کامل را بنویسید
PREMIUM_BACKHAUL_BINARY="/opt/alfa/tunnel-binaries/backhaul_premium"      # مثال: /opt/alfa/tunnel-binaries/premium-backhaul
BROKEN_NODE_BINARY="/opt/alfa/tunnel-binaries/brokennode"           # مثال: /opt/alfa/tunnel-binaries/broken-node

# Repositoryهای گیت (نصب از Release یا Build از سورس)
PACKET_TUNNEL_REPOSITORY="https://github.com/LivingG0D/paqet"     # مثال: https://github.com/user/packet-tunnel
PACKET_TUNNEL_REF=""            # tag/branch مثل v1.2.0
BACKPACK_REPOSITORY="https://github.com/AminMGMT/BackPack"
BACKPACK_REF=""
PING_TUNNEL_REPOSITORY="https://github.com/ppouria/ping-tunnel"
PING_TUNNEL_REF=""
RATHOLE_REPOSITORY="https://github.com/Musixal/rathole-tunnel"
RATHOLE_REF=""

# توکن GitHub (فقط اگر Repository خصوصی است). رمزگذاری‌شده ذخیره می‌شود.
GITHUB_TOKEN=""
